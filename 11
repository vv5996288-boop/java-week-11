1. Create Database and Table in MySQL
CREATE DATABASE studentdb;
USE studentdb;
CREATE TABLE student (
    rollno INT PRIMARY KEY,
    name VARCHAR(50),
    address VARCHAR(100)
);
INSERT INTO student VALUES (101, 'Ravi', 'Vijayawada');
INSERT INTO student VALUES (102, 'Sita', 'Guntur');
INSERT INTO student VALUES (103, 'John', 'Hyderabad');
2. JSP Program (display.jsp)
<%@ page import="java.sql.*" %>

<html>
<head>
    <title>Database Access in JSP</title>
</head>

<body>

<h2>Student Records</h2>

<%
Connection con = null;
Statement st = null;
ResultSet rs = null;

try {
    // Load Driver
    Class.forName("com.mysql.cj.jdbc.Driver");

    // Connect to database
    con = DriverManager.getConnection(
        "jdbc:mysql://localhost:3306/studentdb",
        "root",
        "password"
    );

    st = con.createStatement();

    // Query
    rs = st.executeQuery("SELECT * FROM student");

%>

<table border="1">
<tr>
    <th>Roll No</th>
    <th>Name</th>
    <th>Address</th>
</tr>
<%
    while(rs.next()) {
%>
<tr>
    <td><%= rs.getInt(1) %></td>
    <td><%= rs.getString(2) %></td>
   <td><%= rs.getString(3) %></td>
</tr>
<%
    }
%>
</table>
<%
} catch(Exception e) {
    out.println("Error: " + e);
} finally {
    if(rs != null) rs.close();
    if(st != null) st.close();
    if(con != null) con.close();
}
%>
</body>
</html>
